{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitHub Issues Dataset",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "repo": {
        "type": "string"
      },
      "number": {
        "type": "integer"
      },
      "title": {
        "type": "string"
      },
      "state": {
        "type": "string"
      },
      "labels": {
        "type": "array"
      },
      "created_at": {
        "type": "string"
      },
      "closed_at": {
        "type": "string"
      }
    }
  }
}
